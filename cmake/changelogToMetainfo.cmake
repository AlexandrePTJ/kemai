#
# kemai_metainfo_releases(<changelog> <version> <out_var>)
# Turns the released sections of CHANGELOG.md ("## [<version>] - <date>", " [alpha]" suffix for alphas) into AppStream
# <release> elements, newest first: section text and "###" headings become <p>, bullets <li> in a <ul>, inline Markdown
# (code spans, links, emphasis) plain text. Keeps the versions up to <version> (every release when it is empty: a
# development build); leaves out [Unreleased] and the 0.x versions.

function(_kemai_metainfo_text text out_var)
    # Placeholders of the list-safe reading below, then inline Markdown, then XML escaping
    string(REPLACE "@KEMAI_SEMICOLON@" ";" text "${text}")
    string(REPLACE "@KEMAI_LBRACKET@" "[" text "${text}")
    string(REPLACE "@KEMAI_RBRACKET@" "]" text "${text}")
    string(REGEX REPLACE "\\[([^]]*)\\]\\([^)]*\\)" "\\1" text "${text}")
    string(REPLACE "`" "" text "${text}")
    string(REGEX REPLACE "\\*\\*([^*]*)\\*\\*" "\\1" text "${text}")
    string(REGEX REPLACE "\\*([^*]+)\\*" "\\1" text "${text}")
    string(REPLACE "&" "&amp;" text "${text}")
    string(REPLACE "<" "&lt;" text "${text}")
    string(REPLACE ">" "&gt;" text "${text}")
    string(STRIP "${text}" text)
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(kemai_metainfo_releases changelog version out_var)
    file(READ "${changelog}" content)
    # One list element per line: semicolons and brackets would split or glue CMake list elements
    string(REPLACE ";" "@KEMAI_SEMICOLON@" content "${content}")
    string(REPLACE "[" "@KEMAI_LBRACKET@" content "${content}")
    string(REPLACE "]" "@KEMAI_RBRACKET@" content "${content}")
    string(REPLACE "\n" ";" lines "${content}")

    set(releases "")
    set(inside FALSE)
    set(body "")
    set(in_list FALSE)
    # A trailing heading closes the last section
    list(APPEND lines "## @KEMAI_LBRACKET@end@KEMAI_RBRACKET@")
    foreach (line IN LISTS lines)
        if (line MATCHES "^## ")
            if (inside)
                if (in_list)
                    string(APPEND body "        </ul>\n")
                endif ()
                string(APPEND releases "    <release version=\"${release_version}\" date=\"${release_date}\"${release_type}>\n"
                        "      <description>\n${body}      </description>\n    </release>\n")
            endif ()
            set(inside FALSE)
            set(body "")
            set(in_list FALSE)
            if (line MATCHES "^## @KEMAI_LBRACKET@([0-9]+\\.[0-9]+\\.[0-9]+)@KEMAI_RBRACKET@ - ([0-9-]+)( @KEMAI_LBRACKET@alpha@KEMAI_RBRACKET@)?")
                set(release_version "${CMAKE_MATCH_1}")
                set(release_date "${CMAKE_MATCH_2}")
                if (CMAKE_MATCH_3)
                    set(release_type " type=\"development\"")
                else ()
                    set(release_type "")
                endif ()
                if (NOT release_version MATCHES "^0\\." AND (NOT version OR release_version VERSION_LESS_EQUAL version))
                    set(inside TRUE)
                endif ()
            endif ()
        elseif (inside)
            if (line MATCHES "^[-*] (.*)")
                _kemai_metainfo_text("${CMAKE_MATCH_1}" item)
                if (NOT in_list)
                    string(APPEND body "        <ul>\n")
                    set(in_list TRUE)
                endif ()
                string(APPEND body "          <li>${item}</li>\n")
            else ()
                string(REGEX REPLACE "^#+ " "" line "${line}")
                _kemai_metainfo_text("${line}" paragraph)
                if (NOT paragraph STREQUAL "")
                    if (in_list)
                        string(APPEND body "        </ul>\n")
                        set(in_list FALSE)
                    endif ()
                    string(APPEND body "        <p>${paragraph}</p>\n")
                endif ()
            endif ()
        endif ()
    endforeach ()

    set(${out_var} "${releases}" PARENT_SCOPE)
endfunction()
